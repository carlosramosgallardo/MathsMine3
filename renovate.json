{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor"
  ],
  "platformAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true
  },
  "major": {
    "dependencyDashboardApproval": false,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "One PR for android-native Gradle minor/patch — majors stay ungrouped and do not automerge",
      "matchManagers": [
        "gradle"
      ],
      "matchFileNames": [
        "apps/android-native/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "android-native",
      "automerge": true
    },
    {
      "description": "AGP 9.3+ needs Gradle 9.5; both Android trees are on Gradle 8.14.5 (PR #105/#92)",
      "matchPackageNames": [
        "com.android.application"
      ],
      "allowedVersions": "<9.0.0"
    },
    {
      "description": "Project uses Kotlin 1.9.25; Kotlin 2.x is a toolchain migration (PR #105)",
      "matchPackageNames": [
        "org.jetbrains.kotlin.android"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "Compose BOM 2025+ needs a newer Compose compiler / Kotlin 2.x (PR #105)",
      "matchPackageNames": [
        "androidx.compose:compose-bom"
      ],
      "allowedVersions": "<2025.0.0"
    },
    {
      "description": "Tailwind CSS 4 is a breaking rewrite; Vercel failed on PR #89",
      "matchPackageNames": [
        "tailwindcss"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "activity-compose 1.13+ requires AGP 8.9.1; this repo is on AGP 8.7.3 / Gradle 8.9",
      "matchPackageNames": [
        "androidx.activity:activity-compose"
      ],
      "allowedVersions": "<1.10.0"
    },
    {
      "description": "core-ktx 1.17+ needs AGP 8.9.1; 1.19+ needs AGP 9.1.0 and compileSdk 37",
      "matchPackageNames": [
        "androidx.core:core-ktx"
      ],
      "allowedVersions": "<1.17.0"
    },
    {
      "description": "lifecycle 2.11+ requires AGP 9.1.0 and compileSdk 37",
      "matchPackagePrefixes": [
        "androidx.lifecycle:"
      ],
      "allowedVersions": "<2.11.0"
    },
    {
      "description": "credentials 1.6+ is built with Kotlin 2.1; project uses Kotlin 1.9.25",
      "matchPackagePrefixes": [
        "androidx.credentials:"
      ],
      "allowedVersions": "<1.6.0"
    },
    {
      "description": "googleid 1.2+ is built with Kotlin 2.1; project uses Kotlin 1.9.25",
      "matchPackageNames": [
        "com.google.android.libraries.identity.googleid:googleid"
      ],
      "allowedVersions": "<1.2.0"
    },
    {
      "description": "kotlinx-coroutines 1.10+ is built with Kotlin 2.1+; project uses Kotlin 1.9.25",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlinx:kotlinx-coroutines"
      ],
      "allowedVersions": "<1.10.0"
    },
    {
      "description": "retrofit 2.12+ is built with Kotlin 2.1; project uses Kotlin 1.9.25",
      "matchPackagePrefixes": [
        "com.squareup.retrofit2:"
      ],
      "allowedVersions": "<2.12.0"
    },
    {
      "description": "wagmi 3.x breaks @web3modal until Reown migration",
      "matchPackageNames": [
        "wagmi"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Blocked after Android CI failure on PR #93 (guardian pin 2026-08-15)",
      "allowedVersions": "<5.0.0",
      "matchPackageNames": [
        "com.squareup.okhttp3:okhttp"
      ]
    },
    {
      "description": "Blocked after Android CI failure on PR #93 (guardian pin 2026-08-15)",
      "allowedVersions": "<5.0.0",
      "matchPackageNames": [
        "com.squareup.okhttp3:logging-interceptor"
      ]
    }
  ]
}
